{
  "schemaVersion": 1,
  "id": "dev.openfinder.plugins.video-analyzer",
  "name": "Video Analyzer",
  "version": "0.1.0",
  "description": "Analyzes selected local videos with the configured local video-analyzer checkout.",
  "author": "OpenFinder",
  "runtime": { "type": "python3", "minimumVersion": "3.9" },
  "entry": "run.py",
  "actions": [
    {
      "id": "analyze-video",
      "title": "Analyze Video",
      "category": "Analysis",
      "selection": { "minItems": 1, "maxItems": 100, "allowDirectories": false },
      "match": {
        "extensions": ["mp4", "avi", "mkv", "mov", "wmv", "flv", "webm", "m4v"],
        "uttypes": [],
        "mimePrefixes": ["video/"],
        "matchMode": "all"
      },
      "output": { "resultType": "videoAnalysisResult", "canCopyToClipboard": false }
    }
  ],
  "permissions": {
    "readFiles": "selected",
    "writeFiles": "taskOutput",
    "network": {
      "required": true,
      "hosts": ["huggingface.co", "cdn-lfs.huggingface.co"]
    },
    "clipboardWrite": false,
    "clipboardRead": false,
    "keychainSecrets": [],
    "remoteAccounts": false,
    "runExternalCommands": true
  },
  "configuration": [
    {
      "key": "analyzerRoot",
      "type": "path",
      "title": "Video Analyzer checkout",
      "required": true
    },
    {
      "key": "analyzerPython",
      "type": "path",
      "title": "Analyzer Python executable",
      "required": false
    },
    {
      "key": "useJoyTag",
      "type": "bool",
      "title": "Enable JoyTag",
      "default": "true",
      "required": false
    }
  ]
}
